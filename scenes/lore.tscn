[node name="dossierInfoLabel" type="Label" parent="dossier/dossierInfo" unique_id=1821687703]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_colors/font_color = Color(1, 1, 0.39215687, 1)
theme_override_fonts/font = ExtResource("4_oo4qk")
theme_override_font_sizes/font_size = 32
text = "Внешность: лицо суровое, но не злое. Глаза уставшие, есть лёгкая щетина. Одет в рубашку и поношенный плащ . Галстук всегда ослаблен, верхняя пуговица рубашки расстегнута. Во время осады принимает образ чумного доктора.

Характер: серьезный, но не мрачный. В работе холоден и расчетлив. Страха не показывает, даже когда внутри все идет не по плану. Чувство юмора ироничное.

Особенности: курит дешевые сигареты. Не берет денег за осаду. Считает, что каждый имеет право на помощь. Жизнь других приоритетнее собственной.

Примечание: любит гранатовый сок"
autowrap_mode = 2
text_direction = 1

